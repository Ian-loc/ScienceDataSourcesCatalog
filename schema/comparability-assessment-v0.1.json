{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ian-loc.github.io/ScienceDataSourcesCatalog/schema/comparability-assessment-v0.1.json",
  "title": "Comparability Assessment v0.1",
  "description": "Contrato inicial para avaliar a comparabilidade de produtos e variáveis em relação a uma operação específica.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "operation_type",
    "input_variable_ids",
    "dimensions",
    "compatibility_class",
    "inference_ceiling",
    "analytical_use_allowed",
    "warnings",
    "review"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^CA[0-9]{6}$"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "visual_overlay",
        "side_by_side_description",
        "spatial_join",
        "temporal_join",
        "aggregation",
        "resampling",
        "index_construction",
        "correlation",
        "regression",
        "causal_inference"
      ]
    },
    "input_variable_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^VR[0-9]{6}$"
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic",
        "population_support",
        "spatial",
        "temporal",
        "methodological",
        "statistical",
        "provenance",
        "legal_ethical"
      ],
      "properties": {
        "semantic": {"$ref": "#/$defs/dimensionAssessment"},
        "population_support": {"$ref": "#/$defs/dimensionAssessment"},
        "spatial": {"$ref": "#/$defs/dimensionAssessment"},
        "temporal": {"$ref": "#/$defs/dimensionAssessment"},
        "methodological": {"$ref": "#/$defs/dimensionAssessment"},
        "statistical": {"$ref": "#/$defs/dimensionAssessment"},
        "provenance": {"$ref": "#/$defs/dimensionAssessment"},
        "legal_ethical": {"$ref": "#/$defs/dimensionAssessment"}
      }
    },
    "compatibility_class": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E"]
    },
    "compatibility_label": {
      "type": "string"
    },
    "harmonization_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "rationale", "reproducible"],
        "properties": {
          "operation": {"type": "string"},
          "rationale": {"type": "string"},
          "parameters": {"type": ["object", "null"]},
          "reproducible": {"type": "boolean"}
        }
      }
    },
    "diagnostics_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "temporal_trend",
          "spatial_autocorrelation",
          "scale_stability",
          "multiple_comparisons",
          "shared_lineage",
          "missingness",
          "confounding",
          "mediation",
          "nonlinearity",
          "lag_structure",
          "sensitivity_analysis",
          "ecological_fallacy"
        ]
      }
    },
    "inference_ceiling": {
      "type": "string",
      "enum": ["N0", "N1", "N2", "N3", "N4", "N5"]
    },
    "analytical_use_allowed": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["automated_draft", "human_reviewed", "approved", "rejected", "deprecated"]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "reviewed_by": {
          "type": ["string", "null"]
        },
        "scientific_rationale": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "$defs": {
    "dimensionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "conditional", "fail", "unknown"]
        },
        "rationale": {
          "type": "string",
          "minLength": 5
        },
        "required_action": {
          "type": ["string", "null"]
        }
      }
    }
  }
}